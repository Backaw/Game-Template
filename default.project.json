{
  "name": "NEW GAME",
  "tree": {
    "$className": "DataModel",

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$ignoreUnknownInstances": true,
      "$path": "src/ReplicatedFirst"
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,

      "Shared": {
        "$className": "Folder",
        "$path": "src/Shared",

        "Packages": {
          "$path": "Packages"
        }
      },

      "Client": {
        "$className": "Folder",
        "$path": "src/Client"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,

      "Server": {
        "$path": "src/Server"
      },

      "Packages": {
        "$path": "ServerPackages"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,

      "Server": {
        "$path": "src/Server.server.luau"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,

      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/Client.client.luau"
        }
      }
    }
  }
}
