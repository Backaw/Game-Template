{
  "editor.semanticHighlighting.enabled": true,
  "editor.formatOnSave": true,
  "robloxLsp.suggestedImports.importScriptChildren": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "robloxLsp.typeChecking.mode": "Strict",
  "robloxLsp.typeChecking.options": {
    "infer-instance-from-unknown": true
  },
  "robloxLsp.workspace.ignoreDir": [
    ".vscode",
    "**/_Index/**",
    "**/Packages/**",
    "**/ServerPackages/**"
  ],

  "luau-lsp.completion.autocompleteEnd": true,
  "luau-lsp.fflags.enableNewSolver": true,
  "luau-lsp.hover.showTableKinds": true,
  "luau-lsp.plugin.maximumRequestBodySize": "20mb",
  "luau-lsp.plugin.enabled": true,
  "luau-lsp.completion.imports.enabled": true,

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "search.exclude": {
    "Packages/**": true,
    "ServerPackages/**": true
  },
  "stylua.targetReleaseVersion": "latest"
}
