{
  "editor.semanticHighlighting.enabled": true,
  "editor.formatOnSave": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "search.exclude": {
    "Packages/**": true,
    "ServerPackages/**": true
  },
  "stylua.targetReleaseVersion": "latest",
  "luau-lsp.completion.autocompleteEnd": true,
  "luau-lsp.fflags.enableNewSolver": false,
  "luau-lsp.hover.showTableKinds": true,
  "luau-lsp.plugin.maximumRequestBodySize": "20mb",
  "luau-lsp.plugin.enabled": true,
  "luau-lsp.completion.imports.enabled": true,
  "luau-lsp.completion.imports.ignoreGlobs": [
    ".vscode",
    "**/_Index/**",
    "Packages",
    "ServerPackages"
  ],
  "luau-lsp.ignoreGlobs": [
    ".vscode",
    "**/_Index/**",
    "Packages",
    "ServerPackages"
  ],
  "extensions.disabled": ["robloxlsp.vscode-roblox-lsp"],
  "problems.excludePatterns": [
    "**/Packages/**",
    "**/ServerPackages/**",
    "**/node_modules/**",
    "**/dist/**"
  ]
}
